# ==========================================
# Job Radar OS - Environment Configuration
# ==========================================

# Port (Railway assigns this automatically)
PORT=4000

# Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
JWT_SECRET=super-secret-jwt-key-replace-in-production
SESSION_HOURS=24

# AI Intelligence (Gemini API Key)
# If set, automatically configures the AI Ingestion & ATS Tailoring features
GEMINI_API_KEY=

# Database Settings (Provided automatically if you link Railway MySQL/MariaDB)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=jobhunt_db

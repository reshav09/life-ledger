# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and change all passwords before running the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Credentials (MariaDB)
# ------------------------------------------------------------------------------
# Root password for database initialization and administrative maintenance.
DB_ROOT_PASSWORD=replace_with_secure_root_password

# Database name created automatically on first run.
DB_NAME=money_tracker

# Standard application database user and password.
DB_USER=money_user
DB_PASSWORD=replace_with_secure_db_password

# ------------------------------------------------------------------------------
# 2. Application Authentication & Session
# ------------------------------------------------------------------------------
# Credentials you use to sign in to the web interface in your browser.
AUTH_USERNAME=admin
AUTH_PASSWORD=replace_with_secure_web_password

# A long random string used to sign JWT session cookies.
# Generate one using: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string_secret

# Session duration in hours before automatic sign-out (default: 4 hours).
SESSION_HOURS=4

# ------------------------------------------------------------------------------
# 3. Optional Port Overrides (if running locally outside Docker)
# ------------------------------------------------------------------------------
# PORT=4000
# HTTPS_PORT=4443

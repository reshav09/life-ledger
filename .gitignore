# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production builds & caches
dist/
frontend/dist/
.vite/
.cache/
*.tsbuildinfo

# Environment & credentials (CRITICAL - NEVER COMMIT)
.env
.env.*
!.env.example
k8s/secret.yaml
!k8s/secret.yaml.example
secrets/
*.pem
*.key
*.cert
*.pfx
*.p12

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Backups & Data Dumps (keep folder via .gitkeep, ignore data dumps)
backups/*
!backups/.gitkeep
*.dump
*.sql.gz

# Health Reports & User Uploads (Personal & Sensitive Data)
health-reports/*
!health-reports/.gitkeep
uploads/*
!uploads/.gitkeep

# OS & Editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
